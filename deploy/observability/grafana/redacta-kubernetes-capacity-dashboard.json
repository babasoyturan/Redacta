{
  "uid": "redacta-k8s-capacity",
  "title": "Redacta Kubernetes Capacity And Scaling",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["redacta", "aks", "capacity", "scaling"],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "constant",
        "query": "redacta",
        "current": {
          "text": "redacta",
          "value": "redacta"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Running Application Pods",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_status_phase{namespace=\"$namespace\",phase=\"Running\"})"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Desired Replicas",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_deployment_spec_replicas{namespace=\"$namespace\"})"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "CPU Request Utilization",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(container_cpu_usage_seconds_total{namespace=\"$namespace\",container!=\"POD\",image!=\"\"}[5m])) / clamp_min(sum(kube_pod_container_resource_requests{namespace=\"$namespace\",resource=\"cpu\"}), 0.001)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Memory Request Utilization",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(container_memory_working_set_bytes{namespace=\"$namespace\",container!=\"POD\",image!=\"\"}) / clamp_min(sum(kube_pod_container_resource_requests{namespace=\"$namespace\",resource=\"memory\"}), 1)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU Usage By Pod",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\",container!=\"POD\",image!=\"\"}[5m]))",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memory Working Set By Pod",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"$namespace\",container!=\"POD\",image!=\"\"})",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "HPA Current Min Max Replicas",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 15 },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"$namespace\"} or vector(0)",
          "legendFormat": "{{horizontalpodautoscaler}} current"
        },
        {
          "refId": "B",
          "expr": "kube_horizontalpodautoscaler_spec_min_replicas{namespace=\"$namespace\"} or vector(0)",
          "legendFormat": "{{horizontalpodautoscaler}} min"
        },
        {
          "refId": "C",
          "expr": "kube_horizontalpodautoscaler_spec_max_replicas{namespace=\"$namespace\"} or vector(0)",
          "legendFormat": "{{horizontalpodautoscaler}} max"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Deployment Availability",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 15 },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_status_replicas_available{namespace=\"$namespace\"}",
          "legendFormat": "{{deployment}} available"
        },
        {
          "refId": "B",
          "expr": "kube_deployment_status_replicas_unavailable{namespace=\"$namespace\"}",
          "legendFormat": "{{deployment}} unavailable"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Pod Phase Distribution",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (phase) (kube_pod_status_phase{namespace=\"$namespace\"})",
          "legendFormat": "{{phase}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Pod Disruption Budget Health",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_poddisruptionbudget_status_current_healthy{namespace=\"$namespace\"}",
          "legendFormat": "{{poddisruptionbudget}} current healthy"
        },
        {
          "refId": "B",
          "expr": "kube_poddisruptionbudget_status_desired_healthy{namespace=\"$namespace\"}",
          "legendFormat": "{{poddisruptionbudget}} desired healthy"
        }
      ]
    }
  ]
}
