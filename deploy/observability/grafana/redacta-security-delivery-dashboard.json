{
  "uid": "redacta-security-delivery",
  "title": "Redacta Security And Delivery Controls",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["redacta", "security", "delivery", "kyverno", "argocd"],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "constant",
        "query": "redacta",
        "current": {
          "text": "redacta",
          "value": "redacta"
        }
      },
      {
        "name": "kyvernoNamespace",
        "type": "constant",
        "query": "kyverno",
        "current": {
          "text": "kyverno",
          "value": "kyverno"
        }
      },
      {
        "name": "argocdNamespace",
        "type": "constant",
        "query": "argocd",
        "current": {
          "text": "argocd",
          "value": "argocd"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Kyverno Admission Controller Pods Ready",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_status_ready{namespace=\"$kyvernoNamespace\",condition=\"true\"})"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Argo CD Pods Ready",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_status_ready{namespace=\"$argocdNamespace\",condition=\"true\"})"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Unsigned Image Blocks Last 1h",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(kyverno_policy_results_total{policy_name=\"redacta-verify-signed-images\",rule_result=~\"fail|error\"}[1h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Unschedulable Pods",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_status_unschedulable{namespace=\"$namespace\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Kyverno Admission Requests",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (resource_request_operation) (rate(kyverno_admission_requests_total[5m]))",
          "legendFormat": "{{resource_request_operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Kyverno Image Verification Results",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (policy_name, rule_name, rule_result) (increase(kyverno_policy_results_total{policy_name=\"redacta-verify-signed-images\"}[30m]))",
          "legendFormat": "{{policy_name}} {{rule_name}} {{rule_result}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Argo CD Application Health",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 15 },
      "targets": [
        {
          "refId": "A",
          "expr": "argocd_app_info",
          "legendFormat": "{{name}} {{health_status}} {{sync_status}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "TLS Certificate Expiration",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 15 },
      "targets": [
        {
          "refId": "A",
          "expr": "(certmanager_certificate_expiration_timestamp_seconds{namespace=\"$namespace\"} - time()) / 86400",
          "legendFormat": "{{name}} days remaining"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 7 },
              { "color": "green", "value": 30 }
            ]
          }
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Failed Pods By Reason",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (kube_pod_container_status_waiting_reason{namespace=\"$namespace\"})",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Network Policy Objects",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (namespace) (kube_networkpolicy_info{namespace=\"$namespace\"})",
          "legendFormat": "{{namespace}}"
        }
      ]
    }
  ]
}
